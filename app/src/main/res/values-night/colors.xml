    <color name="text_primary">@color/neutral_50</color>
    <color name="text_secondary">@color/neutral_300</color>
    <color name="text_tertiary">@color/neutral_400</color>
    <color name="text_disabled">@color/neutral_600</color>
    <color name="text_on_primary">@color/on_primary</color>
    <color name="text_on_secondary">@color/on_secondary</color>
    <color name="text_on_tertiary">@color/on_tertiary</color>
    <color name="text_error">@color/error</color>

