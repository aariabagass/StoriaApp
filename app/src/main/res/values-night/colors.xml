    <color name="stroke_primary">@color/primary</color>
    <color name="stroke_divider">@color/neutral_800</color>
    <color name="stroke_outline">@color/neutral_400</color>
    <color name="stroke_focus">@color/primary_200</color>
    <color name="stroke_error">@color/error</color>

    <!-- Icon -->
    <color name="icon_primary">@color/primary</color>
    <color name="icon_secondary">@color/neutral_200</color>
    <color name="icon_muted">@color/neutral_400</color>
